# All VITE_* values are public browser configuration. NEVER put secrets here.
VITE_APP_TITLE=智慧校舍管理系统
VITE_APP_PORT=3000
VITE_APP_BASE_API=/dev-api
VITE_APP_API_URL=http://127.0.0.1:8000
VITE_MOCK_DEV_SERVER=false
# Put machine-specific public overrides in .env.development.local (ignored).
# Model keys, JWT signing keys and database credentials belong ONLY on the backend.
